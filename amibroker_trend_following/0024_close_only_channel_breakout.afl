// Close-Only Channel Breakout

SetOption("InitialEquity", Param("Initial Equity", 100000, 10000, 1000000, 10000));
SetOption("MaxOpenPositions", Param("Max Open Positions", 10, 1, 50, 1));
SetOption("AllowSameBarExit", False);
SetTradeDelays(1, 1, 1, 1);
SetPositionSize(Param("Position % Equity", 8, 1, 100, 1), spsPercentOfEquity);

entryLen = Param("Entry Close Channel", 80, 20, 300, 10);
exitLen = Param("Exit Close Channel", 30, 5, 150, 5);
atrLen = Param("ATR Length", 20, 5, 100, 1);

upperClose = Ref(HHV(Close, entryLen), -1);
lowerClose = Ref(LLV(Close, entryLen), -1);
exitLow = Ref(LLV(Close, exitLen), -1);
exitHigh = Ref(HHV(Close, exitLen), -1);

Buy = Close > upperClose;
Sell = Close < exitLow;
Short = Close < lowerClose;
Cover = Close > exitHigh;

ApplyStop(stopTypeTrailing, stopModePoint, 4 * ATR(atrLen), True, True);

Buy = ExRem(Buy, Sell);
Sell = ExRem(Sell, Buy);
Short = ExRem(Short, Cover);
Cover = ExRem(Cover, Short);

Plot(Close, "Close", colorDefault, styleCandle);
Plot(upperClose, "Upper Close Channel", colorGreen, styleLine);
Plot(lowerClose, "Lower Close Channel", colorRed, styleLine);
