// Connors-Style Short-Term Pullback

SetOption("InitialEquity", Param("Initial Equity", 100000, 10000, 1000000, 10000));
SetOption("MaxOpenPositions", Param("Max Open Positions", 10, 1, 50, 1));
SetOption("AllowSameBarExit", False);
SetTradeDelays(1, 1, 1, 1);
SetPositionSize(Param("Position % Equity", 6, 1, 100, 1), spsPercentOfEquity);

trendLen = Param("Trend EMA", 100, 20, 300, 5);
rsiLen = Param("RSI Length", 3, 2, 10, 1);
entryRSI = Param("Entry RSI", 15, 2, 35, 1);
streakBars = Param("Streak Bars", 3, 2, 6, 1);
maxHold = Param("Max Hold Bars", 4, 1, 5, 1);
atrLen = Param("ATR Length", 14, 5, 50, 1);

trendEMA = EMA(Close, trendLen);
r = RSI(rsiLen);
downStreak = Sum(Close < Ref(Close, -1), streakBars) == streakBars;
upStreak = Sum(Close > Ref(Close, -1), streakBars) == streakBars;

Buy = Close > trendEMA AND downStreak AND r < entryRSI;
Sell = r > 60 OR Close < Ref(Low, -1);
Short = Close < trendEMA AND upStreak AND r > 100 - entryRSI;
Cover = r < 40 OR Close > Ref(High, -1);

ApplyStop(stopTypeNBar, stopModeBars, maxHold, True);
ApplyStop(stopTypeLoss, stopModePoint, 1.5 * ATR(atrLen), True);
ApplyStop(stopTypeProfit, stopModePoint, 2.2 * ATR(atrLen), True);

Buy = ExRem(Buy, Sell);
Sell = ExRem(Sell, Buy);
Short = ExRem(Short, Cover);
Cover = ExRem(Cover, Short);

Plot(Close, "Close", colorDefault, styleCandle);
Plot(trendEMA, "Trend EMA", colorBlue, styleLine);
