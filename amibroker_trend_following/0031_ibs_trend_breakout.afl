// Internal Bar Strength Trend Breakout

SetOption("InitialEquity", Param("Initial Equity", 100000, 10000, 1000000, 10000));
SetOption("MaxOpenPositions", Param("Max Open Positions", 10, 1, 50, 1));
SetOption("AllowSameBarExit", False);
SetTradeDelays(1, 1, 1, 1);
SetPositionSize(Param("Position % Equity", 8, 1, 100, 1), spsPercentOfEquity);

trendLen = Param("Trend EMA", 150, 40, 400, 10);
breakoutLen = Param("Breakout Length", 20, 5, 100, 5);
ibsLongMax = Param("Long Setup IBS Max", 0.35, 0.05, 0.60, 0.05);
ibsShortMin = Param("Short Setup IBS Min", 0.65, 0.40, 0.95, 0.05);
atrLen = Param("ATR Length", 20, 5, 100, 1);

barRange = High - Low;
ibs = (Close - Low) / Max(barRange, 0.01);
trendEMA = EMA(Close, trendLen);
upper = Ref(HHV(High, breakoutLen), -1);
lower = Ref(LLV(Low, breakoutLen), -1);

longSetup = Close > trendEMA AND BarsSince(ibs < ibsLongMax) < 8;
shortSetup = Close < trendEMA AND BarsSince(ibs > ibsShortMin) < 8;

Buy = longSetup AND Close > upper;
Sell = Close < trendEMA;
Short = shortSetup AND Close < lower;
Cover = Close > trendEMA;

ApplyStop(stopTypeTrailing, stopModePoint, 3 * ATR(atrLen), True, True);

Buy = ExRem(Buy, Sell);
Sell = ExRem(Sell, Buy);
Short = ExRem(Short, Cover);
Cover = ExRem(Cover, Short);

Plot(Close, "Close", colorDefault, styleCandle);
Plot(trendEMA, "Trend EMA", colorBlue, styleLine);
