// Turtle Soup False Breakout

SetOption("InitialEquity", Param("Initial Equity", 100000, 10000, 1000000, 10000));
SetOption("MaxOpenPositions", Param("Max Open Positions", 10, 1, 50, 1));
SetOption("AllowSameBarExit", False);
SetTradeDelays(1, 1, 1, 1);
SetPositionSize(Param("Position % Equity", 6, 1, 100, 1), spsPercentOfEquity);

lookback = Param("Breakout Lookback", 20, 10, 80, 5);
minBarsSinceExtreme = Param("Min Bars Since Extreme", 4, 1, 20, 1);
maxHold = Param("Max Hold Bars", 4, 1, 5, 1);
atrLen = Param("ATR Length", 14, 5, 50, 1);

priorLow = Ref(LLV(Low, lookback), -1);
priorHigh = Ref(HHV(High, lookback), -1);
priorLowAge = LLVBars(Ref(Low, -1), lookback);
priorHighAge = HHVBars(Ref(High, -1), lookback);

falseLowBreak = Low < priorLow AND Close > priorLow AND priorLowAge >= minBarsSinceExtreme;
falseHighBreak = High > priorHigh AND Close < priorHigh AND priorHighAge >= minBarsSinceExtreme;

Buy = falseLowBreak;
Sell = Close < priorLow;
Short = falseHighBreak;
Cover = Close > priorHigh;

ApplyStop(stopTypeNBar, stopModeBars, maxHold, True);
ApplyStop(stopTypeLoss, stopModePoint, 1.3 * ATR(atrLen), True);
ApplyStop(stopTypeProfit, stopModePoint, 2.3 * ATR(atrLen), True);

Buy = ExRem(Buy, Sell);
Sell = ExRem(Sell, Buy);
Short = ExRem(Short, Cover);
Cover = ExRem(Cover, Short);

Plot(Close, "Close", colorDefault, styleCandle);
Plot(priorLow, "Prior Low", colorGreen, styleLine);
Plot(priorHigh, "Prior High", colorRed, styleLine);
