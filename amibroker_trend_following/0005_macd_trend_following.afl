// MACD Trend Following With Long-Term Filter

SetOption("InitialEquity", Param("Initial Equity", 100000, 10000, 1000000, 10000));
SetOption("MaxOpenPositions", Param("Max Open Positions", 10, 1, 50, 1));
SetOption("AllowSameBarExit", False);
SetTradeDelays(1, 1, 1, 1);
SetPositionSize(Param("Position % Equity", 10, 1, 100, 1), spsPercentOfEquity);

fastLen = Param("MACD Fast", 12, 4, 40, 1);
slowLen = Param("MACD Slow", 26, 10, 80, 1);
signalLen = Param("MACD Signal", 9, 3, 30, 1);
trendLen = Param("Trend EMA", 200, 50, 400, 10);
atrLen = Param("ATR Length", 20, 5, 100, 1);
atrStop = Param("ATR Stop", 4, 1, 10, 0.25);

macdLine = EMA(Close, fastLen) - EMA(Close, slowLen);
signalLine = EMA(macdLine, signalLen);
trendEMA = EMA(Close, trendLen);

Buy = Cross(macdLine, signalLine) AND Close > trendEMA;
Sell = Cross(signalLine, macdLine) OR Close < trendEMA;
Short = Cross(signalLine, macdLine) AND Close < trendEMA;
Cover = Cross(macdLine, signalLine) OR Close > trendEMA;

ApplyStop(stopTypeTrailing, stopModePoint, atrStop * ATR(atrLen), True, True);

Buy = ExRem(Buy, Sell);
Sell = ExRem(Sell, Buy);
Short = ExRem(Short, Cover);
Cover = ExRem(Cover, Short);

Plot(Close, "Close", colorDefault, styleCandle);
Plot(trendEMA, "Trend EMA", colorBlue, styleLine);
Plot(macdLine, "MACD", colorGreen, styleOwnScale);
Plot(signalLine, "Signal", colorRed, styleOwnScale);
