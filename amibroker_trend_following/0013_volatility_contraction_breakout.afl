// Volatility Contraction Breakout

SetOption("InitialEquity", Param("Initial Equity", 100000, 10000, 1000000, 10000));
SetOption("MaxOpenPositions", Param("Max Open Positions", 10, 1, 50, 1));
SetOption("AllowSameBarExit", False);
SetTradeDelays(1, 1, 1, 1);
SetPositionSize(Param("Position % Equity", 8, 1, 100, 1), spsPercentOfEquity);

breakoutLen = Param("Breakout Channel", 40, 10, 200, 5);
quietLen = Param("Quiet Range Lookback", 7, 3, 30, 1);
atrLen = Param("ATR Length", 20, 5, 100, 1);
atrMaxRatio = Param("ATR / Avg ATR Max", 0.85, 0.4, 1.5, 0.05);
exitLen = Param("Exit Channel", 18, 5, 100, 1);

dayRange = High - Low;
quietRange = dayRange <= Ref(LLV(dayRange, quietLen), -1);
quietATR = ATR(atrLen) < atrMaxRatio * MA(ATR(atrLen), atrLen);
upper = Ref(HHV(High, breakoutLen), -1);
lower = Ref(LLV(Low, breakoutLen), -1);

Buy = Close > upper AND Ref(quietRange AND quietATR, -1);
Sell = Close < Ref(LLV(Low, exitLen), -1);
Short = Close < lower AND Ref(quietRange AND quietATR, -1);
Cover = Close > Ref(HHV(High, exitLen), -1);

Buy = ExRem(Buy, Sell);
Sell = ExRem(Sell, Buy);
Short = ExRem(Short, Cover);
Cover = ExRem(Cover, Short);

Plot(Close, "Close", colorDefault, styleCandle);
Plot(upper, "Breakout High", colorGreen, styleLine);
Plot(lower, "Breakout Low", colorRed, styleLine);
