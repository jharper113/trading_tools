// Relative Strength Trend Following

SetOption("InitialEquity", Param("Initial Equity", 100000, 10000, 1000000, 10000));
SetOption("MaxOpenPositions", Param("Max Open Positions", 10, 1, 50, 1));
SetOption("AllowSameBarExit", False);
SetTradeDelays(1, 1, 1, 1);
SetPositionSize(Param("Position % Equity", 8, 1, 100, 1), spsPercentOfEquity);

benchmark = ParamStr("Benchmark Symbol", "SPY");
rsLen = Param("RS MA Length", 80, 20, 250, 10);
priceLen = Param("Price EMA", 100, 20, 300, 10);
atrLen = Param("ATR Length", 20, 5, 100, 1);

benchmarkClose = Foreign(benchmark, "C");
relativeStrength = Close / benchmarkClose;
rsMA = MA(relativeStrength, rsLen);
priceEMA = EMA(Close, priceLen);

Buy = Close > priceEMA AND Cross(relativeStrength, rsMA);
Sell = Close < priceEMA OR Cross(rsMA, relativeStrength);
Short = Close < priceEMA AND Cross(rsMA, relativeStrength);
Cover = Close > priceEMA OR Cross(relativeStrength, rsMA);

ApplyStop(stopTypeTrailing, stopModePoint, 4 * ATR(atrLen), True, True);

Buy = ExRem(Buy, Sell);
Sell = ExRem(Sell, Buy);
Short = ExRem(Short, Cover);
Cover = ExRem(Cover, Short);

Plot(Close, "Close", colorDefault, styleCandle);
Plot(priceEMA, "Price EMA", colorBlue, styleLine);
Plot(relativeStrength, "Relative Strength", colorGreen, styleOwnScale);
