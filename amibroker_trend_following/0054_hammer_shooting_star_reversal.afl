// Hammer / Shooting Star Reversal

SetOption("InitialEquity", Param("Initial Equity", 100000, 10000, 1000000, 10000));
SetOption("MaxOpenPositions", Param("Max Open Positions", 10, 1, 50, 1));
SetOption("AllowSameBarExit", False);
SetTradeDelays(1, 1, 1, 1);
SetPositionSize(Param("Position % Equity", 6, 1, 100, 1), spsPercentOfEquity);

atrLen = Param("ATR Length", 14, 5, 50, 1);
minRangeATR = Param("Min Range ATR", 1.0, 0.3, 4, 0.1);
wickBodyRatio = Param("Wick / Body Ratio", 2.5, 1, 8, 0.25);
trendLen = Param("Trend EMA", 60, 10, 200, 5);
maxHold = Param("Max Hold Bars", 4, 1, 5, 1);

barRange = High - Low;
body = Max(abs(Close - Open), 0.01);
lowerWick = Min(Open, Close) - Low;
upperWick = High - Max(Open, Close);
trendEMA = EMA(Close, trendLen);

hammer = barRange > minRangeATR * ATR(atrLen) AND lowerWick > wickBodyRatio * body AND upperWick < body;
shootingStar = barRange > minRangeATR * ATR(atrLen) AND upperWick > wickBodyRatio * body AND lowerWick < body;

Buy = hammer AND Close > Open AND Close > trendEMA;
Sell = Close < Ref(Low, -1);
Short = shootingStar AND Close < Open AND Close < trendEMA;
Cover = Close > Ref(High, -1);

ApplyStop(stopTypeNBar, stopModeBars, maxHold, True);
ApplyStop(stopTypeLoss, stopModePoint, 1.4 * ATR(atrLen), True);
ApplyStop(stopTypeProfit, stopModePoint, 2.2 * ATR(atrLen), True);

Buy = ExRem(Buy, Sell);
Sell = ExRem(Sell, Buy);
Short = ExRem(Short, Cover);
Cover = ExRem(Cover, Short);

Plot(Close, "Close", colorDefault, styleCandle);
Plot(trendEMA, "Trend EMA", colorBlue, styleLine);
