// Triangular Moving Average Trend Following

SetOption("InitialEquity", Param("Initial Equity", 100000, 10000, 1000000, 10000));
SetOption("MaxOpenPositions", Param("Max Open Positions", 10, 1, 50, 1));
SetOption("AllowSameBarExit", False);
SetTradeDelays(1, 1, 1, 1);
SetPositionSize(Param("Position % Equity", 8, 1, 100, 1), spsPercentOfEquity);

fastLen = Param("Fast TMA", 35, 5, 150, 5);
slowLen = Param("Slow TMA", 150, 40, 400, 10);
exitLen = Param("Exit TMA", 50, 10, 200, 5);
atrLen = Param("ATR Length", 20, 5, 100, 1);

fastTMA = MA(MA(Close, fastLen), fastLen);
slowTMA = MA(MA(Close, slowLen), slowLen);
exitTMA = MA(MA(Close, exitLen), exitLen);

Buy = Cross(fastTMA, slowTMA);
Sell = Cross(exitTMA, Close);
Short = Cross(slowTMA, fastTMA);
Cover = Cross(Close, exitTMA);

ApplyStop(stopTypeTrailing, stopModePoint, 4 * ATR(atrLen), True, True);

Buy = ExRem(Buy, Sell);
Sell = ExRem(Sell, Buy);
Short = ExRem(Short, Cover);
Cover = ExRem(Cover, Short);

Plot(Close, "Close", colorDefault, styleCandle);
Plot(fastTMA, "Fast TMA", colorGreen, styleLine);
Plot(slowTMA, "Slow TMA", colorRed, styleLine);
